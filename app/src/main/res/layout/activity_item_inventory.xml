<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_inventory_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        android:gravity="center_vertical">

        <!-- Product Icon -->

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_blue_circle"
            android:gravity="center">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_inventory" />

        </LinearLayout>

        <!-- Product Info -->

        <!-- Action Buttons -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="117dp"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Product Name -->

            <TextView
                android:id="@+id/txtProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucky Me Pancit Canton"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Barcode -->

            <TextView
                android:id="@+id/txtBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barcode : 480001234567" />

            <!-- Category -->

            <!-- Price -->

            <TextView
                android:id="@+id/txtCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category : Noodles"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price : ₱18.00"
                android:textStyle="bold" />

            <!-- Stock -->

            <TextView
                android:id="@+id/txtStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock : 45"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="Edit"/>

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E53935"
                android:text="Delete"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
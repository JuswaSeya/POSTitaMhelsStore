<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/utangDetailsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2563EB"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="Utang Details"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </LinearLayout>


    <!-- CUSTOMER INFORMATION -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Customer Name -->

            <TextView
                android:id="@+id/txtCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Juan Dela Cruz"
                android:textColor="#111827"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <!-- Contact -->

            <TextView
                android:id="@+id/txtContactNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="09123456789"
                android:textColor="#6B7280"
                android:textSize="15sp"/>


            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:background="#E5E7EB"/>


            <!-- Overall Balance -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overall Balance"
                android:textColor="#6B7280"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtOverallBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="₱500.00"
                android:textColor="#DC2626"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <!-- Payment Button -->

            <Button
                android:id="@+id/btnRecordPayment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Record Payment"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16A34A"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- TRANSACTION HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Utang History"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnAddUtang"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="+ Add Utang"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"/>

    </LinearLayout>


    <!-- UTANG LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUtangDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>


    <!-- PAYMENT SUMMARY -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account Summary"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtTotalUtang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Total Utang: ₱1,000.00"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtTotalPaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Paid: ₱500.00"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtRemainingBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Remaining Balance: ₱500.00"
                android:textColor="#DC2626"
                android:textSize="17sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>